# Use either Gemini Developer API or Vertex AI authentication.
GEMINI_API_KEY=

# Vertex AI / Cloud Run mode. Leave GOOGLE_GENAI_USE_VERTEXAI=false for the
# Gemini Developer API. Set it to true on Cloud Run and grant the runtime service
# account Vertex AI access.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=false

# Override the model without changing source code.
AGENT_ANTIBODY_MODEL=gemini-3.5-flash

# Enable only for controlled demos. The live endpoint makes real model calls.
AGENT_ANTIBODY_LIVE_ENABLED=false
AGENT_ANTIBODY_LIVE_CACHE_SECONDS=600
AGENT_ANTIBODY_ATTACK_SUITE_ATTEMPTS=3
AGENT_ANTIBODY_EXPORT_TRACES=false
